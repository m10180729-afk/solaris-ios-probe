<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SolarisNativeHost</AssemblyName>
    <RootNamespace>SolarisNativeHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.4.0.63</Version>
    <FileVersion>0.4.0.63</FileVersion>
    <AssemblyVersion>0.4.0.63</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Solaris.Transport/Solaris.Transport.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <EmbeddedResource Include="../../ios/App/Resources/solaris-desktop.html">
      <LogicalName>SolarisNativeHost.solaris-desktop.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../shared/*">
      <LogicalName>SolarisNativeHost.app.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
